CREATE TABLE lastSelectedMeasureEntity(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    body_measure TEXT NOT NULL,
    timestamp INTEGER NOT NULL
);

getLastSelectedMeasure:
SELECT *
FROM lastSelectedMeasureEntity
ORDER BY timestamp DESC;

deleteAllLastSelectedMeasure:
DELETE FROM lastSelectedMeasureEntity;

insertLastSelectedMeasureEntity:
INSERT OR REPLACE
INTO lastSelectedMeasureEntity(
    body_measure,
    timestamp
)
VALUES( ?, ?);